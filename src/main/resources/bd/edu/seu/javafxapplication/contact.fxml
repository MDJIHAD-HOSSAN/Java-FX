<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bd.edu.seu.javafxapplication.ContactController">
   <children>
      <Label layoutX="235.0" layoutY="33.0" text="Contact Form">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="119.0" layoutY="86.0" text="Name : ">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="nameFeild" layoutX="119.0" layoutY="114.0" prefHeight="25.0" prefWidth="234.0" />
      <Label layoutX="119.0" layoutY="162.0" text="Address : ">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="addressFeild" layoutX="119.0" layoutY="188.0" prefHeight="25.0" prefWidth="234.0" />
      <Label layoutX="119.0" layoutY="237.0" text="Mobile : ">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="mobileFeild" layoutX="119.0" layoutY="267.0" prefHeight="25.0" prefWidth="234.0" />
      <Button layoutX="215.0" layoutY="328.0" mnemonicParsing="false" onAction="#setSubmitButtonAction" text="Submit" />
      <Label fx:id="mobileError" layoutX="119.0" layoutY="292.0" prefHeight="17.0" prefWidth="234.0" textFill="#e40c0c" />
      <Label fx:id="massage" layoutX="361.0" layoutY="78.0" prefHeight="17.0" prefWidth="234.0" textFill="#17e408" />
      <Button layoutX="324.0" layoutY="328.0" mnemonicParsing="false" onAction="#setSignOutAciton" text="Sign Out" />
   </children>
</AnchorPane>
