<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bd.edu.seu.javafxapplication.RegistrationController">
   <children>
      <Label layoutX="198.0" layoutY="27.0" text="Registration Form">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="115.0" layoutY="97.0" text="Name : ">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="115.0" layoutY="142.0" text="Email : ">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="99.0" layoutY="201.0" text="Password : ">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="36.0" layoutY="252.0" text="Confirm Password : ">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button layoutX="265.0" layoutY="318.0" mnemonicParsing="false" onAction="#setRegisterButtonAction" text="Register" />
      <TextField fx:id="nameFeild" layoutX="198.0" layoutY="98.0" prefHeight="25.0" prefWidth="256.0" />
      <TextField fx:id="emailFeild" layoutX="198.0" layoutY="143.0" prefHeight="25.0" prefWidth="256.0" />
      <PasswordField fx:id="passwordField" layoutX="198.0" layoutY="202.0" prefHeight="25.0" prefWidth="256.0" />
      <PasswordField fx:id="confirmPassFeild" layoutX="198.0" layoutY="253.0" prefHeight="25.0" prefWidth="256.0" />
   </children>
</AnchorPane>
